# Salin berkas ini menjadi `.env` lalu isi dengan nilai rahasia yang sesungguhnya.
# JANGAN commit `.env` ke git (lihat .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=vulnflow
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=vulnflow
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=change-me-to-a-strong-password
REDIS_PORT=6379

# --- MinIO (Object Storage, S3-compatible) ---
MINIO_ROOT_USER=vulnflow
MINIO_ROOT_PASSWORD=change-me-to-a-strong-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Backend API (apps/api) — FASE 2 ---
# SQLAlchemy connection string ke Postgres di atas (psycopg3 driver).
# Pakai 127.0.0.1, BUKAN `localhost`: di Windows + Docker Desktop, `localhost`
# bisa resolve ke ::1 lebih dulu sementara port mapping container hanya bind
# IPv4, sehingga psycopg kadang menggantung saat connect tanpa pesan error
# (gejalanya: `alembic upgrade head` diam sampai di-Ctrl+C). 127.0.0.1
# menghilangkan ketidakpastian urutan resolusi DNS tersebut.
DATABASE_URL=postgresql+psycopg://vulnflow:change-me-to-a-strong-password@127.0.0.1:5432/vulnflow
# Database terpisah & sekali-pakai untuk lane uji PostgreSQL
# (`tests/models/test_postgres_semantics.py`). Fixture-nya DROP SCHEMA public —
# jangan pernah arahkan ke database yang berisi data nyata.
# TEST_DATABASE_URL=postgresql+psycopg://vulnflow:change-me-to-a-strong-password@127.0.0.1:5432/vulnflow_test
# Kunci master AES-256-GCM untuk enkripsi at-rest proofs_of_concept (SDD §2.4.3).
# Wajib 32 byte ter-base64-encode. Generate: `python -c "import secrets,base64;
# print(base64.b64encode(secrets.token_bytes(32)).decode())"`
ENCRYPTION_MASTER_KEY=change-me-to-a-base64-encoded-32-byte-key

# --- Backend API (apps/api) — FASE 4 ---
# Secret HMAC untuk signing/verifikasi JWT (SDD §2.6.1.4). Generate:
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=change-me-to-a-strong-random-secret
JWT_ALGORITHM=HS256
# Durasi token akses 24 jam, lihat SRS §revision 3.2.0 / SDD §2.6.1.4.
JWT_EXPIRES_IN_SECONDS=86400

# Redis/Celery broker (reuse container Redis di atas, DB index berbeda).
CELERY_BROKER_URL=redis://:change-me-to-a-strong-password@127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://:change-me-to-a-strong-password@127.0.0.1:6379/0
REDIS_URL=redis://:change-me-to-a-strong-password@127.0.0.1:6379/0

# S3-compatible object storage (MinIO lokal di atas; ganti utk S3 AWS asli).
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=vulnflow
S3_SECRET_KEY=change-me-to-a-strong-password
S3_BUCKET_NAME=vulnflow-reports
S3_REGION=us-east-1

# Transactional SMTP Email (Mailpit lokal via docker-compose.yml: UI http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@vulnflow.local
SMTP_ENABLED=true
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
APP_BASE_URL=http://localhost:5173

# Superadmin Seeding & TOTP MFA (UC-17..19)
SEED_ADMIN_PASSWORD=VulnFlow-Seed-Admin-2026!
SEED_ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP
AI_MONTHLY_SPEND_CEILING_USD=100.0

# Google Gemini API (FASE 4.6 AIRouter) — https://aistudio.google.com/apikey
GEMINI_API_KEY=change-me-to-a-real-gemini-api-key
GEMINI_MODEL=gemini-3-flash-preview

# Midtrans Snap (FASE 4.8 BillingRouter) — https://dashboard.midtrans.com
MIDTRANS_SERVER_KEY=change-me-to-a-real-midtrans-server-key
MIDTRANS_IS_PRODUCTION=false

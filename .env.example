# Salin berkas ini menjadi `.env` lalu isi dengan nilai rahasia yang sesungguhnya.
# JANGAN commit `.env` ke git (lihat .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=vulnflow
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=vulnflow
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=change-me-to-a-strong-password
REDIS_PORT=6379

# --- MinIO (Object Storage, S3-compatible) ---
MINIO_ROOT_USER=vulnflow
MINIO_ROOT_PASSWORD=change-me-to-a-strong-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

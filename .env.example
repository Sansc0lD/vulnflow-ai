# Salin berkas ini menjadi `.env` lalu isi dengan nilai rahasia yang sesungguhnya.
# JANGAN commit `.env` ke git (lihat .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=vulnflow
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=vulnflow
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=change-me-to-a-strong-password
REDIS_PORT=6379

# --- MinIO (Object Storage, S3-compatible) ---
MINIO_ROOT_USER=vulnflow
MINIO_ROOT_PASSWORD=change-me-to-a-strong-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Backend API (apps/api) — FASE 2 ---
# SQLAlchemy connection string ke Postgres di atas (psycopg3 driver).
DATABASE_URL=postgresql+psycopg://vulnflow:change-me-to-a-strong-password@localhost:5432/vulnflow
# Kunci master AES-256-GCM untuk enkripsi at-rest proofs_of_concept (SDD §2.4.3).
# Wajib 32 byte ter-base64-encode. Generate: `python -c "import secrets,base64;
# print(base64.b64encode(secrets.token_bytes(32)).decode())"`
ENCRYPTION_MASTER_KEY=change-me-to-a-base64-encoded-32-byte-key
